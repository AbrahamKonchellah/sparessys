@model SparePartsWeb.Models.Equipment

@{
    ViewData["Title"] = "Equipment Details";
}

<h2 class="mb-4">Equipment Details</h2>

<div class="card p-4 shadow-sm">
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>

        <dt class="col-sm-3">Purchase Date</dt>
        <dd class="col-sm-9">@Model.PurchaseDate.ToShortDateString()</dd>

        <dt class="col-sm-3">Last Maintenance Date</dt>
        <dd class="col-sm-9">@Model.LastMaintenanceDate?.ToShortDateString()</dd>

        <dt class="col-sm-3">Book Value</dt>
        <dd class="col-sm-9">@Model.BookValue.ToString("C")</dd>
    </dl>

    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
