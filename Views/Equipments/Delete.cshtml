@model SparePartsWeb.Models.Equipment

@{
    ViewData["Title"] = "Delete Equipment";
}

<h2 class="mb-4 text-danger">Delete Equipment</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this equipment?
</div>

<div class="card p-4 shadow-sm">
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Brand</dt>
        <dd class="col-sm-9">@Model.Brand</dd>

        <dt class="col-sm-3">Book Value</dt>
        <dd class="col-sm-9">@Model.BookValue.ToString("C")</dd>
    </dl>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
