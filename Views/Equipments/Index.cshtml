@model IEnumerable<SparePartsWeb.Models.Equipment>

@{
    ViewData["Title"] = "Equipments";
}

<h2>Equipments</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Equipment</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Last Maintenance Date</th>
            <th>Book Value</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Category</td>
            <td>@(item.LastMaintenanceDate?.ToShortDateString() ?? "N/A")</td>
            <td>@item.BookValue</td>
        </tr>
    }
    </tbody>
</table>
