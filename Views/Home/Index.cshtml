@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
    <h2 class="mb-4 text-center">📊 Spare Parts Management Dashboard</h2>

    <!-- Summary Cards -->
    <div class="row text-center mb-4">
        <div class="col-md-4">
            <div class="card bg-primary text-white shadow-sm">
                <div class="card-body">
                    <h5>Total Spare Parts</h5>
                    <h3>@ViewBag.TotalSpareParts</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white shadow-sm">
                <div class="card-body">
                    <h5>Total Vendors</h5>
                    <h3>@ViewBag.TotalVendors</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-danger text-white shadow-sm">
                <div class="card-body">
                    <h5>Low Stock Items</h5>
                    <h3>@ViewBag.LowStockCount</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Restock Recommendations -->
    <div class="card mb-4 border-info shadow-sm">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h5>🔁 Restock Recommendations (Target: 10 units)</h5>
            <a asp-action="GenerateRestockReport" class="btn btn-light btn-sm text-dark">
                📄 Generate PDF Report
            </a>
        </div>
        <div class="card-body">
            @if (ViewBag.LowStockParts != null && ViewBag.LowStockParts.Count > 0)
            {
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Brand</th>
                            <th>Quantity</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var part in ViewBag.LowStockParts)
                        {
                            <tr>
                                <td>@part.Name</td>
                                <td>@part.Brand</td>
                                <td class="text-danger fw-bold">@part.Quantity</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">🎉 All parts are above minimum stock levels.</p>
            }
        </div>
    </div>

    <!-- Recent Additions -->
    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <h5>🆕 Recent Spare Parts</h5>
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var p in ViewBag.RecentSpareParts)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@p.Name (@p.Brand)</span>
                            <small class="text-muted">Qty: @p.Quantity</small>
                        </li>
                    }
                </ul>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5>🤝 Recent Vendors</h5>
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var v in ViewBag.RecentVendors)
                    {
                        <li class="list-group-item">
                            <strong>@v.Name</strong> — <small>@v.ContactEmail</small>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
}
