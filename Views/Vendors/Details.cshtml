@model SparePartsWeb.Models.Vendor

@{
    ViewData["Title"] = "Vendor Details";
}

<h2>Vendor Details</h2>

<div class="card p-3">
    <h4>@Model.Name</h4>
    <p><strong>Email:</strong> @Model.ContactEmail</p>
    <p><strong>Phone:</strong> @Model.Phone</p>
    <p><strong>Address:</strong> @Model.Address</p>
    <p><strong>Average Lead Time:</strong> @Model.AverageLeadTimeDays days</p>
    <p><strong>Rating: 0-10</strong> @Model.ReliabilityScore</p>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning mt-3">Edit</a>
<a asp-action="Index" class="btn btn-secondary mt-3">Back</a>
